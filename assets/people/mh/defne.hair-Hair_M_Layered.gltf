      "extras": {
        "groom": {
          "groom": "Hair_M_Layered",
          "slot": "Hair",
          "lod": 0,
          "layout": "Card Compact (EHairTextureLayout::Layout2)",
          "colour": {
            "melanin": 0.719,
            "redness": 0.021,
            "whiteness": 0,
            "white_seed_below": 0,
            "white_share": 0,
            "fibre_linear": [
              0.0335,
              0.0124,
              0.0021
            ],
            "fibre_white_linear": [
              0.1856,
              0.1774,
