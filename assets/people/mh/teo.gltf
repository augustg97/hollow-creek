    {
      "name": "mh_hair:Hair_S_SweptUp",
      "extras": {
        "groom": {
          "groom": "Hair_S_SweptUp",
          "slot": "Hair",
          "lod": 2,
          "layout": "Card Compact (EHairTextureLayout::Layout2)",
          "colour": {
            "melanin": 0.802,
            "redness": 0.021,
            "whiteness": 0,
            "white_seed_below": 0,
            "white_share": 0,
            "fibre_linear": [
              0.0169,
