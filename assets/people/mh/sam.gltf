      "extras": {
        "groom": {
          "groom": "Hair_S_Messy",
          "slot": "Hair",
          "lod": 1,
          "layout": "Card Compact (EHairTextureLayout::Layout2)",
          "colour": {
            "melanin": 0.365,
            "redness": 0.062,
            "whiteness": 0,
            "white_seed_below": 0,
            "white_share": 0,
            "fibre_linear": [
              0.2446,
              0.161,
              0.0755
            ],
            "fibre_white_linear": [
              0.2447,
              0.2356,
              0.2253
            ],
            "swatch_linear": [
              0.2457,
              0.1616,
              0.074
            ],
            "white_linear": [
              0.7758,
              0.7529,
              0.7084
            ],
            "mean_linear": [
              0.2457,
              0.1616,
              0.074
            ],
            "model": "M_hair_v4: fibre = HairColor(melanin^2.2, redness) (GetHairColorFromMelanin, HairShadingCommon.ush), white strands where seed < 1.08·whiteness (soft 0.05) with fibre_white; swatch = T_HairColorImage at (melanin, redness) with white_linear (#E4E1DB) for plain PBR; mean = the swatch and white mixed by white_share"
          },
          "channels": {
            "baseColorTexture": "sRGB, for plain PBR: RGB the strand colour (swatch, or white where seed < white_seed_below), darker with depth and toward the root; A opacity = (2 coverage)^0.5 as M_hair_v4 (baseColorFactor 1)",
            "occlusionTexture": "linear: Unreal's Coverage | Depth | Seed atlas: R coverage, G depth, B seed",
            "emissiveTexture": "linear data (emissiveFactor 0): Unreal's Tangent | CoordU atlas: RGB (t+1)/2 with t = (U·s, V·s, N·s), U = +u, V = +v = TANGENT.w·TANGENT.xyz, N = normal (t.y is about -1 here: stored tip → root); A CoordU (root 0 → tip 1)",
            "TANGENT": "xyz strand direction on the card, root → tip; w = +1 when xyz runs along +v of TEXCOORD_0, -1 along -v (some cards are mapped upside down)"
          },
          "shadow": true
        }
      },
      "alphaMode": "MASK",
      "alphaCutoff": 0.5,
      "doubleSided": true,
      "pbrMetallicRoughness": {
        "roughnessFactor": 0.5,
        "metallicFactor": 0,
