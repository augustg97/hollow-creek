      "extras": {
        "groom": {
          "groom": "Hair_S_SideSweptFringe",
          "slot": "Hair",
          "lod": 0,
          "layout": "Card Compact (EHairTextureLayout::Layout2)",
          "colour": {
            "melanin": 0.594,
            "redness": 0.854,
            "whiteness": 0,
            "white_seed_below": 0,
            "white_share": 0,
            "fibre_linear": [
