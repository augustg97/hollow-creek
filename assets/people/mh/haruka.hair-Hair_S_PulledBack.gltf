          "layout": "Card Compact (EHairTextureLayout::Layout2)",
          "colour": {
            "melanin": 0.865,
            "redness": 0.021,
            "whiteness": 0,
            "white_seed_below": 0,
            "white_share": 0,
            "fibre_linear": [
