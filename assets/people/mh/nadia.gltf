    {
      "name": "mh_hair:Hair_S_AfroFade",
      "extras": {
        "groom": {
          "groom": "Hair_S_AfroFade",
          "slot": "Hair",
          "lod": 0,
          "layout": "Card Compact (EHairTextureLayout::Layout2)",
          "colour": {
            "melanin": 0.906,
            "redness": 0.062,
            "whiteness": 0,
            "white_seed_below": 0,
            "white_share": 0,
            "fibre_linear": [
              0.005,
              0.001,
              0.0001
            ],
            "fibre_white_linear": [
              0.1643,
