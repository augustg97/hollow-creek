      },
      "occlusionTexture": {
        "index": 2
      }
    },
    {
      "name": "mh_teeth",
      "extras": {
        "orm": "R occlusion (the mouth occlusion mask), G roughness, B specular level in Unreal's convention (F0 = 0.08·B; glTF would read B as metalness: metallicFactor 0 cancels it), A the same specular in glTF's (KHR_materials_specular specularTexture: F0 = 0.04·A, F90 = A)",
        "dim_reflections": {
          "range": 0.05,
          "influence": 1,
          "on": true,
          "formula": "specular × lerp(1, saturate(smoothstep(0, range, dot(R, V))), influence), R = reflect(−V, N) (N the vertex normal, V toward the eye): 2·(N·V)² − 1, so reflections fade out beyond ~45° from facing"
        },
        "regions": {
          "teeth": {
            "roughness": 0.175,
            "specular_unreal": 0.09,
            "F0": 0.0072,
            "mouth_occlusion": 0.731
          },
          "tongue": {
            "roughness": 0.35,
            "specular_unreal": 0.35,
            "F0": 0.028,
            "mouth_occlusion": 0.451
          },
