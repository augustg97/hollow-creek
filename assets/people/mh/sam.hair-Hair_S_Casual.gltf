      "name": "mh_hair:Hair_S_Casual",
      "extras": {
        "groom": {
          "groom": "Hair_S_Casual",
          "slot": "Hair",
          "lod": 0,
          "layout": "Card Compact (EHairTextureLayout::Layout2)",
          "colour": {
            "melanin": 0.365,
            "redness": 0.062,
            "whiteness": 0,
            "white_seed_below": 0,
            "white_share": 0,
            "fibre_linear": [
              0.2446,
              0.161,
              0.0755
            ],
            "fibre_white_linear": [
              0.2447,
