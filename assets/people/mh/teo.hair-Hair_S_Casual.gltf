      "extras": {
        "groom": {
          "groom": "Hair_S_Casual",
          "slot": "Hair",
          "lod": 0,
          "layout": "Card Compact (EHairTextureLayout::Layout2)",
          "colour": {
            "melanin": 0.802,
            "redness": 0.021,
            "whiteness": 0,
            "white_seed_below": 0,
            "white_share": 0,
            "fibre_linear": [
