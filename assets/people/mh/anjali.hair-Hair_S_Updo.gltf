      "name": "mh_hair:Hair_S_Updo",
      "extras": {
        "groom": {
          "groom": "Hair_S_Updo",
          "slot": "Hair",
          "lod": 0,
          "layout": "Card Compact (EHairTextureLayout::Layout2)",
          "colour": {
            "melanin": 0.865,
            "redness": 0.021,
            "whiteness": 0,
            "white_seed_below": 0,
            "white_share": 0,
            "fibre_linear": [
              0.0086,
              0.0021,
              0.0002
            ],
            "fibre_white_linear": [
              0.1677,
              0.1598,
